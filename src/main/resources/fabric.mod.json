{
  "schemaVersion": 1,
  "id": "cytra-shulkerview",
  "version": "${version}",
  "name": "Alloy Shulker View",
  "description": "Shows what's inside shulker boxes and other containers: an item icon when one item type is inside, a fill bar, and a tooltip preview (compact or every slot). Works on shulker, chest and bundle items and on placed shulkers. Optional on the server (live placed labels, ender chest preview).",
  "authors": ["steelaspect"],
  "contact": {
    "sources": "https://github.com/SteelAspect/cytra-shulkerview",
    "issues": "https://github.com/SteelAspect/cytra-shulkerview/issues"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/cytra-shulkerview/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.steelaspect.shulkerview.ShulkerViewServer"],
    "client": ["dev.steelaspect.shulkerview.client.ShulkerViewClient"],
    "modmenu": ["dev.steelaspect.shulkerview.client.compat.ModMenuIntegration"]
  },
  "mixins": [
    "cytra-shulkerview.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*",
    "alloy-ui": ">=1.4.0 <2.0.0"
  }
}
